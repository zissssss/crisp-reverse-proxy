# DNS Resolver (Critical for dynamic upstream resolution)
resolver 8.8.8.8 1.1.1.1 valid=300s;
resolver_timeout 5s;

# Proxy Settings
proxy_ssl_server_name on;
proxy_ssl_protocols TLSv1.2 TLSv1.3;
proxy_http_version 1.1;
proxy_set_header Connection "";

# Security: Referer Whitelist
# none = allow requests with no referer (e.g. direct access, apps)
# blocked = allow requests with obfuscated referer
# server_names = allow this server's own name
valid_referers none blocked server_names ${ALLOWED_DOMAINS};

# --------------------------------------------------------
# HTTP Redirect & ACME Challenge (Port 80)
# --------------------------------------------------------
server {
    listen 80;
    server_name ${CLIENT_DOMAIN} ${IMAGE_DOMAIN} ${RELAY_DOMAIN} ${CLIENT_RELAY_DOMAIN} ${GAME_DOMAIN} ${GO_DOMAIN} ${MEDIA_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --------------------------------------------------------
# 1. CLIENT DOMAIN
# --------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${CLIENT_DOMAIN};

    ssl_certificate /etc/nginx/certs/live/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/privkey.pem;

    location / {
        # Dynamic resolution to prevent startup crash
        set $backend "https://client.crisp.chat";
        proxy_pass $backend;
        
        proxy_ssl_name client.crisp.chat;
        proxy_set_header Host client.crisp.chat;
        proxy_set_header Accept-Encoding "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        sub_filter_types text/javascript application/javascript application/x-javascript text/css application/json;
        
        sub_filter 'client.crisp.chat' '${CLIENT_DOMAIN}';
        sub_filter 'image.crisp.chat' '${IMAGE_DOMAIN}';
        sub_filter 'client.relay.crisp.chat' '${CLIENT_RELAY_DOMAIN}';
        sub_filter 'wss://client.relay.crisp.chat' 'wss://${CLIENT_RELAY_DOMAIN}';
        sub_filter 'relay.crisp.chat' '${RELAY_DOMAIN}';
        sub_filter 'wss://relay.crisp.chat' 'wss://${RELAY_DOMAIN}';
        sub_filter 'game.crisp.chat' '${GAME_DOMAIN}';
        sub_filter 'go.crisp.chat' '${GO_DOMAIN}';
        sub_filter 'media.crisp.chat' '${MEDIA_DOMAIN}';
        
        sub_filter_once off;

        # Block illegal usage
        if ($invalid_referer) {
            return 403;
        }
    }
}

# --------------------------------------------------------
# 2. IMAGE DOMAIN
# --------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${IMAGE_DOMAIN};

    ssl_certificate /etc/nginx/certs/live/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/privkey.pem;

    location / {
        set $backend "https://image.crisp.chat";
        proxy_pass $backend;
        
        proxy_ssl_name image.crisp.chat;
        proxy_set_header Host image.crisp.chat;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# --------------------------------------------------------
# 3. RELAY (WEBSOCKET) DOMAINS
# --------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${RELAY_DOMAIN} ${CLIENT_RELAY_DOMAIN};

    ssl_certificate /etc/nginx/certs/live/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/privkey.pem;

    location / {
        set $backend "https://client.relay.crisp.chat";
        proxy_pass $backend;
        
        proxy_ssl_name client.relay.crisp.chat;
        proxy_set_header Host client.relay.crisp.chat;
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # WebSocket might have different referer behavior, but usually follows same rules
        if ($invalid_referer) {
            return 403;
        }
    }
}

